# ============================================================
# Saudi Invoice SaaS - Environment Configuration
# Copy this file to .env and update with your values
# ============================================================

# Server Configuration
NODE_ENV=production
PORT=3000
APP_NAME=Saudi Invoice SaaS
APP_VERSION=1.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=invoice_user
DB_PASSWORD=your_secure_password_here
DB_NAME=saudi_invoice_saas

# Database Connection Pool
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# CORS Configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# API Configuration
API_BASE_URL=http://localhost:3000/api
API_TIMEOUT=30000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ZATCA Configuration (Phase 1)
ZATCA_VERSION=1.0
ZATCA_QR_SIZE=100

# Email Configuration (for Phase 1.5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=invoices@company.com

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# PDF Generation
PDF_TIMEOUT=30000
PDF_MARGIN_TOP=80
PDF_MARGIN_BOTTOM=20
PDF_MARGIN_LEFT=20
PDF_MARGIN_RIGHT=20

# QR Code
QR_ERROR_CORRECTION=H
QR_TYPE=image/png

# Feature Flags (for future phases)
FEATURE_EMAIL_INVOICES=false
FEATURE_DIGITAL_SIGNATURE=false
FEATURE_AUTO_SUBMISSION=false

# Hostinger Specific (if using Hostinger)
HOSTINGER_CPANEL_USER=your_cpanel_user
HOSTINGER_SSH_PORT=22

# Analytics (optional)
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=google
ANALYTICS_ID=your_analytics_id

# Debug Mode
DEBUG=false
VERBOSE_LOGGING=false

# ============================================================
# NOTES:
# 1. Never commit .env to version control
# 2. Use strong passwords for production
# 3. Change JWT_SECRET in production
# 4. Update DB credentials for your setup
# 5. For Hostinger: Get credentials from cPanel
# ============================================================
